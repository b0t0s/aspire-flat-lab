# flat-lab configuration. Copy to .env; one file feeds both layers:
#   - docker-compose.yml (infra): ${KEY} interpolation, missing required keys fail `docker compose up`
#   - apphost.cs (Aspire app stack): secrets become Aspire parameters named after the key
#   - systemd (configs/systemd/flat-lab.service): EnvironmentFile, so NO inline comments after values
#
# Keys under a "[manual]" comment must be supplied by an operator or another system.
#
# Ports are NOT configured here. Host ports are generated per homepage group (docs/ports.md,
# locked in configs/ports.json); only a whole group can be moved with PORT_PREFIX_<GROUP>.

## =====================================================================
## CORE
## =====================================================================
FLAT_LAB_NETWORK=flat_lab_net
DUCKDNS_DOMAIN=__PLACEHOLDER__.duckdns.org
RUSTDESK_RELAY_IP=__PLACEHOLDER__.duckdns.org
# [manual] duckdns.org / my.zerotier.com
ZEROTIER_NETWORK_ID=__PLACEHOLDER__
DUCKDNS_TOKEN=__PLACEHOLDER__
TZ=Europe/Kyiv
PUID=1000
PGID=1000
DOCKER_GID=124

DNS1=
DNS2=

## =====================================================================
## NOT WIRED YET
## =====================================================================
# rustdesk-hbbs runs without `-r <relay>`; wire into docker-compose.yml if clients need it
RUSTDESK_RELAY_IP=
HOMEPAGE_TITLE=Flat lab
HOMEPAGE_THEME=terminal
HOMEPAGE_COLOR=gray
HOMEPAGE_HIDE_STOPPED=true
OPENMETEO_LABEL=Home
OPENMETEO_LAT=
OPENMETEO_LON=
OPENMETEO_TZ=
# filebrowser runs with FB_NOAUTH=true
FILEBROWSER_QUANTUM_USER=
FILEBROWSER_QUANTUM_PASSWORD=
FILEBROWSER_WIDGET_USER=
FILEBROWSER_WIDGET_PASSWORD=

## =====================================================================
## ASPIRE APP STACK
## =====================================================================
# Resources stay visible in the dashboard; false = stopped until started manually.
ASPIRE_DASHBOARD_FRONTEND_BROWSERTOKEN=
ASPIRE_START_DEVELOPMENT_BY_DEFAULT=false
ASPIRE_START_SECRETS_BY_DEFAULT=false
ASPIRE_START_SMARTHOME_BY_DEFAULT=false
ASPIRE_START_ENTERTAINMENT_BY_DEFAULT=false
ASPIRE_START_MEDIA_BY_DEFAULT=false
ASPIRE_START_KNOWLEDGE_BY_DEFAULT=false
ASPIRE_START_CHAT_BY_DEFAULT=false
ASPIRE_START_IRL_BY_DEFAULT=false

# Optional: move a whole port group (defaults 10..18, see docs/ports.md).
# PORT_PREFIX_DEVELOPMENT=11

