FROM alpine:3.21 AS source

RUN apk add --no-cache git
ARG SOURCE_COMMIT=626b6a238f2f1f3d45f8a9faa8bea9b3cba46769
RUN git init /source \
    && git -C /source remote add origin https://github.com/TheoFABIEN/Trailkeepr.git \
    && git -C /source fetch --depth 1 origin "$SOURCE_COMMIT" \
    && git -C /source checkout --detach FETCH_HEAD

FROM postgis/postgis:16-3.4

COPY --from=source /source/init/ini.sql /docker-entrypoint-initdb.d/10-trailkeepr.sql