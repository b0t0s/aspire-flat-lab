FROM alpine:3.21 AS source

RUN apk add --no-cache git
ARG SOURCE_COMMIT=e0a9e6cf27bddc54893ce2944c2d06964eeeeaff
RUN git init /source \
    && git -C /source remote add origin https://github.com/RackDaddyDCIM/RackDaddy-Lab.git \
    && git -C /source fetch --depth 1 origin "$SOURCE_COMMIT" \
    && git -C /source checkout --detach FETCH_HEAD

FROM node:22-alpine AS builder

WORKDIR /app
COPY --from=source /source/client/ ./
RUN npm install && npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=source /source/client/nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's|http://api:3002|http://rack:3002|g' /etc/nginx/conf.d/default.conf \
    && find /usr/share/nginx/html -type d -exec chmod 755 {} + \
    && find /usr/share/nginx/html -type f -exec chmod 644 {} +

EXPOSE 80