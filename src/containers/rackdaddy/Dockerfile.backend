FROM alpine:3.21 AS source

RUN apk add --no-cache git
ARG SOURCE_COMMIT=e0a9e6cf27bddc54893ce2944c2d06964eeeeaff
RUN git init /source \
    && git -C /source remote add origin https://github.com/RackDaddyDCIM/RackDaddy-Lab.git \
    && git -C /source fetch --depth 1 origin "$SOURCE_COMMIT" \
    && git -C /source checkout --detach FETCH_HEAD

FROM node:22-alpine

RUN apk add --no-cache git tar
WORKDIR /app
COPY --from=source /source/server/ ./
RUN npm install --omit=dev \
    && npx prisma generate \
    && mkdir -p uploads/devices uploads/cabinets uploads/qrcodes

EXPOSE 3001
CMD ["sh", "/app/docker-entrypoint.sh"]