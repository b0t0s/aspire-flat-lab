# The port to Listen on.
PORT:8080
# The number of workers to use for the server
HTTP_WORKERS:2
# Proxy
PROXY_PART:${PROXY_PART}
# Public API URL
API_URL:${API_URL}
# Public Frontend URL
FRONTEND_URL:${FRONTEND_URL}
# Enable haveibeenpwned compromised password API
COMPROMISED_PASSWORD_CHECK:false
# Feed Retention Time in Days
FEED_RETENTION:30
# RYD Proxy URL (see https://github.com/TeamPiped/RYD-Proxy)
RYD_PROXY_URL:https://ryd-proxy.kavin.rocks
# SponsorBlock Servers(s)
SPONSORBLOCK_SERVERS:https://sponsor.ajay.app
# How long should unauthenticated subscriptions last for
SUBSCRIPTIONS_EXPIRY:30
# Hibernate properties
hibernate.connection.url:jdbc:postgresql://piped-db:5432/piped
hibernate.connection.driver_class:org.postgresql.Driver
hibernate.dialect:org.hibernate.dialect.PostgreSQLDialect
hibernate.connection.username:piped
hibernate.connection.password:${PIPED_DB_PASSWORD}