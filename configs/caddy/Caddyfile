# Put a login in front of a route: add `import tinyauth` as the first line inside its handle block.
(tinyauth) {
    forward_auth auth:3000 {
        uri /api/auth/caddy
        copy_headers Remote-User Remote-Email Remote-Name Remote-Groups
    }
}

