    @forum host forum.{$DUCKDNS_DOMAIN}
    # Both path AND host must match: without the host clause, /api/* on every subdomain
    # (homepage, dashboard, ...) would be routed here to forum:8536 and 502.
    @forum_api {
        path /api/* /api/v3/* /pictrs/* /inbox* /site_outbox* /nodeinfo* /.well-known/*
        host forum.{$DUCKDNS_DOMAIN}
    }
    handle @forum_api {
        reverse_proxy forum:8536
    }
    handle @forum {
        reverse_proxy forum-ui:1234
    }

