    @xmpp host xmpp.{$DUCKDNS_DOMAIN} converse.{$DUCKDNS_DOMAIN}
    handle @xmpp {
        # Ejabberd BOSH / WebSocket / admin API
        @ejabberd path /bosh /bosh/* /ws /ws/* /websocket /websocket/* /http-bind /http-bind/* /api /api/*
        handle @ejabberd {
            reverse_proxy xmpp-server:5280
        }
        # Converse.js static web client (default for everything else)
        handle {
            reverse_proxy xmpp:80
        }
    }

    @ytdl host ytdl.{$DUCKDNS_DOMAIN}
    handle @ytdl {
        reverse_proxy ytdl:8081
    }

    # Fallback
    handle {
        abort
    }
}
